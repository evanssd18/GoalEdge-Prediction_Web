# Copy to backend/.env and fill in. Never commit the real file.

# Real bookmaker odds (the-odds-api.com) — required for value / edge
ODDS_API_KEY=
ODDS_API_REGIONS=uk
ODDS_API_MARKETS=h2h,totals
ODDS_API_CACHE_SECONDS=43200
ODDS_API_MAX_SPORTS_PER_RUN=4

# API-Football / API-Sports dashboard key (dashboard.api-football.com)
API_FOOTBALL_KEY=

# Optional — leave blank for the built-in offline analyst
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Change before deploying anywhere real
JWT_SECRET=change-me-in-production-goaledge-secret

# Required on Vercel (SQLite cannot persist there)
# DATABASE_URL=postgresql+psycopg://user:pass@host/db
