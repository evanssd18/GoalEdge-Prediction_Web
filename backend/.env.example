# Copy to .env and edit.

# SQLite by default. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/goaledge
DATABASE_URL=

# Optional. Leave blank to use the built-in rule-based analyst (works offline).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Change this before deploying anywhere real.
JWT_SECRET=change-me-in-production-goaledge-secret

# Model tuning
MARKET_BLEND=0.28
DIXON_COLES_RHO=-0.06
VALUE_EDGE_THRESHOLD=0.045
# SportyBet market board (display only — never blended into the model).
# Off by default. The feed is unofficial and bot-protected; see README.
SPORTYBET_MARKETS_ENABLED=false
SPORTYBET_BASE_URL=https://www.sportybet.com/api
SPORTYBET_COUNTRY=ng
# Team badges. "auto" prefers a local file when present, else the remote
# dataset. Set to "local" for production: the app then makes no third-party
# requests, and you supply your own licensed badges in BADGE_DIR.
LOGO_SOURCE=auto
# BADGE_DIR=backend/app/static/badges
